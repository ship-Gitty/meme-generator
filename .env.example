# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth — from console.cloud.google.com > APIs & Services > Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Postgres (Neon-backed) — from Vercel dashboard > Storage tab
DATABASE_URL=

# Vercel Blob — from Vercel dashboard > Storage tab
BLOB_READ_WRITE_TOKEN=
