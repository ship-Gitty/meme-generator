# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth — from console.cloud.google.com > APIs & Services > Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Postgres (Neon-backed) — from Vercel dashboard > Storage tab
DATABASE_URL=

# Vercel Blob — from Vercel dashboard > Storage tab
BLOB_READ_WRITE_TOKEN=

# Anthropic Claude — from console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Giphy — from developers.giphy.com (use the production key, not beta, once approved)
GIPHY_API_KEY=

# Google Gemini — from aistudio.google.com > Get API Key
GEMINI_API_KEY=

# OpenAI Moderation API — from platform.openai.com > API Keys
OPENAI_API_KEY=

# Upstash Redis — from the database's REST API tab at upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Curated template library manifest — printed by `npm run seed:templates`
TEMPLATES_MANIFEST_URL=
